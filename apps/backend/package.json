{
  "name": "@bot/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --experimental-strip-types --import ./scripts/register-ts.mjs src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "node --experimental-strip-types --import ./scripts/register-ts.mjs --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^3.0.58",
    "@ai-sdk/google": "^4.0.87",
    "@fastify/static": "^10.1.5",
    "@tavily/core": "^0.7.13",
    "ai": "^7.0.127",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.6.1",
    "sharp": "^0.35.5",
    "zalo-bot-js": "^0.2.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.18.6",
    "@types/sharp": "^0.32.0",
    "typescript": "^5.9.2"
  }
}
