{
  "name": "family-bot-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22",
    "pnpm": ">=12"
  },
  "scripts": {
    "dev": "concurrently -n backend,admin -c green,cyan \"pnpm --filter @bot/backend dev\" \"pnpm --filter @bot/admin dev\"",
    "dev:backend": "pnpm --filter @bot/backend dev",
    "dev:admin": "pnpm --filter @bot/admin dev",
    "build": "pnpm --filter @bot/admin build && pnpm --filter @bot/backend build",
    "build:admin": "pnpm --filter @bot/admin build",
    "build:backend": "pnpm --filter @bot/backend build",
    "start": "pnpm --filter @bot/backend start",
    "test": "pnpm --filter @bot/backend test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.9.2"
  }
}
