ZALO_BOT_TOKEN=
FAMILY_CHAT_IDS=            # Comma-separated list (e.g. zgr-98a4f1a7dfc5369b6fd4,zgr-second123)
FAMILY_CHAT_ID=             # Backward-compatible single group ID
ADMIN_SENDER_IDS=
ADMIN_PASSWORD=admin123     # Password to access Web Admin Dashboard at /admin

# LLM Provider: "gemini" or "deepseek" (auto-detected if omitted)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# DeepSeek alternative:
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat

DB_PATH=/data/family.db
WEBHOOK_URL=https://your-domain.example/webhooks/zalo
WEBHOOK_SECRET=
MODE=webhook
PORT=3000
BOT_ID=

# Web Search (optional) — get a free API key at https://tavily.com (1,000 searches/month free)
TAVILY_API_KEY=

# Distributed Scheduler via Redis & BullMQ (optional)
# - Docker Compose: Leave REDIS_URL commented out; docker-compose automatically defaults to redis://redis:6379.
# - Local host dev with local Redis: Set REDIS_URL=redis://127.0.0.1:6379.
# - Local dev without Redis: Leave empty to use the built-in in-memory timer scheduler.
# REDIS_URL=redis://redis:6379
SCHEDULER_CONCURRENCY=5

